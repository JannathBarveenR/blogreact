# ─────────────────────────────────────────────────────────────────────────────
# PetOLife — Root .env example
#
# Copy this file to .env and fill in values for your environment.
# Note: Root .env only controls Docker configuration.
# Application secrets go in backend/.env
#
#   For LOCAL testing:
#     cp .env.example .env
#     (defaults are already correct for local)
#
#   For PRODUCTION server:
#     cp .env.example .env
#     Uncomment the PRODUCTION block below and comment the LOCAL block.
# ─────────────────────────────────────────────────────────────────────────────

# --- LOCAL (default) ---------------------------------------------------------
ENVIRONMENT=development
NGINX_CONF=./nginx/nginx-local.conf
FRONTEND_URL=http://localhost
VITE_API_BASE_URL=
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# --- PRODUCTION --------------------------------------------------------------
# ENVIRONMENT=production
# NGINX_CONF=./nginx/nginx.conf
# FRONTEND_URL=https://petolife.com
# VITE_API_BASE_URL=https://petolife.com
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your-anon-key
