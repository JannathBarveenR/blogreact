# ─────────────────────────────────────────────────────────────────────────────
# PetOLife — Frontend Dockerfile (Multi-stage: Node build → Caddy server)
# ─────────────────────────────────────────────────────────────────────────────

# ─── Stage 1: Build ───────────────────────────────────────────────────────────
FROM node:20-alpine AS builder

WORKDIR /app

# Install dependencies in a cached layer
COPY package.json package-lock.json ./
RUN npm ci --legacy-peer-deps --ignore-scripts

COPY . .

# Production build — Vite bakes these env vars into the static JS bundle
ARG VITE_API_BASE_URL=""
ARG VITE_SUPABASE_URL=""
ARG VITE_SUPABASE_ANON_KEY=""

ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
ENV VITE_SUPABASE_URL=$VITE_SUPABASE_URL
ENV VITE_SUPABASE_ANON_KEY=$VITE_SUPABASE_ANON_KEY

RUN npm run build

# ─── Stage 2: Production Caddy Server ────────────────────────────────────────
FROM caddy:2-alpine AS runner

# Copy compiled React SPA to Caddy's default root
COPY --from=builder /app/dist /srv

# Caddyfile is mounted at runtime via docker-compose
EXPOSE 80 443

HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
    CMD wget --quiet --tries=1 --spider http://localhost/ || exit 1

LABEL org.opencontainers.image.title="PetOLife Frontend" \
      org.opencontainers.image.description="React SPA served by Caddy" \
      org.opencontainers.image.vendor="PetOLife"
