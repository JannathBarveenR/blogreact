# ─────────────────────────────────────────────────────────────────────────────
# PetOLife — Backend .env example
#
# Copy this file to .env and fill in the values.
# IMPORTANT: Never commit the actual .env file.
# ─────────────────────────────────────────────────────────────────────────────
PORT=8000
ENVIRONMENT=development

# Supabase — get these from your Supabase Dashboard
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# SECURITY: The anon key is required for public/unauthenticated requests
# It must be set separately and never fall back to the service role key.
SUPABASE_ANON_KEY=your-anon-key

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Frontend URL
FRONTEND_URL=http://localhost:5173
